# ── Database ─────────────────────────────────────────────────────
# PostgreSQL / Supabase connection string (pooler — used at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Direct URL used by Prisma for migrations (pooler with pgbouncer=false)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=false"

# ── Authentication ────────────────────────────────────────────────
# Strong random string (min 32 chars) — generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET"

# DIFFERENT secret for refresh tokens — generate independently:
#   openssl rand -hex 32
REFRESH_TOKEN_SECRET="CHANGE_ME_DIFFERENT_FROM_JWT_SECRET"

# ── Redis ─────────────────────────────────────────────────────────
# Used for OAuth one-time codes. Falls back to in-memory if not set.
# In Docker: redis://redis:6379
# Local dev: redis://localhost:6379 (or leave empty to use in-memory fallback)
REDIS_URL="redis://localhost:6379"

# ── Server ────────────────────────────────────────────────────────
PORT=3001

# ── Frontend ─────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"

# ── Email (Resend) ────────────────────────────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXX"
RESEND_FROM_EMAIL="noreply@your-domain.com"

# ── File Storage (Supabase Storage) ──────────────────────────────
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── AI (Anthropic Claude) ────────────────────────────────────────
# Get your API key at https://console.anthropic.com
# Used for AI-powered opportunity generation (POST /ai/generate-opportunity)
# Leave empty to disable the feature gracefully — the endpoint returns 503
ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXXXXXXXXX"

# ── Google OAuth (optional) ──────────────────────────────────────
# Create credentials at https://console.cloud.google.com
# Callback URL: ${BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
