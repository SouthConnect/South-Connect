# ─────────────────────────────────────────────────────────────────────────────
# D-Fund — Variables d'environnement (exemple)
# Copier ce fichier en .env à la racine et remplir toutes les valeurs.
# Ne jamais committer le .env réel.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Supabase) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── JWT ──────────────────────────────────────────────────────────────────────
# Générer : openssl rand -hex 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Générer : openssl rand -hex 32
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://southconnect.io
BACKEND_URL=https://api.southconnect.io
ENFORCE_EMAIL_VERIFICATION=true

# REQUIS en production : domaine partagé entre le backend (api.southconnect.io)
# et le frontend (southconnect.io) pour que les cookies auth soient lisibles
# par le middleware Next.js côté Vercel.
# Le point initial inclut tous les sous-domaines.
COOKIE_DOMAIN=.southconnect.io

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@votre-domaine.com

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry (optionnel) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Anthropic AI (optionnel) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Next.js (build-time — passer via docker-compose.prod.yml build.args) ──────
NEXT_PUBLIC_API_URL=https://votre-domaine.com/api/v1
NEXT_PUBLIC_WS_URL=https://votre-domaine.com
NEXT_PUBLIC_SENTRY_DSN=
