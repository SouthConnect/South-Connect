generator client {
  provider        = "prisma-client-js"
  output          = "../backend/node_modules/.prisma/client"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                   @id @default(cuid())
  email                        String                   @unique
  firstName                    String?
  lastName                     String?
  name                         String?
  password                     String?
  role                         UserRole                 @default(USER)
  bio                          String?
  profilePic                   String?
  headerImage                  String?
  phone                        String?
  city                         String?
  country                      String?
  linkedinUrl                  String?
  website                      String?
  visibility                   Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  googleId                     String?                  @unique
  passwordResetExpiry          DateTime?
  passwordResetToken           String?                  @unique
  emailVerificationToken       String?                  @unique
  isEmailVerified              Boolean                  @default(false)
  isBanned                     Boolean                  @default(false)
  emailOptOut                  Boolean                  @default(false)
  emailUnsubscribeToken        String?                  @unique
  emailVerificationTokenExpiry DateTime?
  passwordChangedAt            DateTime?
  deletedAt                    DateTime?
  adminAuditLogs               AdminAuditLog[]
  applications                 Application[]
  btoBProfile                  BtoBProfile?
  btoCProfile                  BtoCProfile?
  followers                    Follow[]                 @relation("Follower")
  following                    Follow[]                 @relation("Following")
  likedOpportunities           LikedOpportunity[]
  receivedMessages             Message[]                @relation("ReceivedMessages")
  sentMessages                 Message[]                @relation("SentMessages")
  notificationPreferences      NotificationPreferences?
  notifications                Notification[]
  opportunities                Opportunity[]
  privateDiscussions           Participant[]            @relation("PrivateDiscussionParticipants")
  publicDiscussions            PublicDiscussion[]
  ratings                      Rating[]
  referralCodes                ReferralCode[]
  savedOpportunities           SavedOpportunity[]
  tasks                        Task[]

  @@index([deletedAt])
  @@index([role, deletedAt])
  @@index([isBanned, deletedAt])
  @@map("users")
}

model BtoCProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  description              String?
  tags                     String[]
  industries               String[]
  marketFocus              String[]
  languages                String[]
  businessSkills           String[]
  techSkills               String[]
  seniorityLevel           String?
  opportunitiesCount       Int      @default(0)
  activeOpportunitiesCount Int      @default(0)
  followersCount           Int      @default(0)
  avgRating                Float?
  roundedRating            Int?
  profileSharedCount       Int      @default(0)
  lookingForOpportunities  Boolean  @default(true)
  remote                   Boolean?
  countries                String[]
  regions                  String[]
  opportunityTypes         String[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bto_c_profiles")
}

model BtoBProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  companyName        String
  logo               String?
  headerImage        String?
  punchline          String?
  description        String?
  longDescription    String?
  website            String?
  linkedinUrl        String?
  city               String?
  country            String?
  foundationDate     DateTime?
  developmentStage   String?
  industries         String[]
  marketFocus        String[]
  followersCount     Int       @default(0)
  opportunitiesCount Int       @default(0)
  profileSharedCount Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bto_b_profiles")
}

model Opportunity {
  id                   String              @id @default(cuid())
  name                 String
  punchline            String?
  description          String?
  type                 OpportunityType
  featureId            String?
  status               OpportunityStatus   @default(DRAFT)
  ownerId              String
  city                 String?
  country              String?
  region               String?
  remote               Boolean?
  startDate            DateTime?
  endDate              DateTime?
  expirationDate       DateTime?
  applicationProcessId String?
  needToCheckApplicant Boolean             @default(false)
  image                String?
  backgroundImage      String?
  file                 String?
  url                  String?
  tags                 String[]
  industries           String[]
  markets              String[]
  price                Decimal?            @db.Decimal(12, 2)
  currency             String?
  pricingUnit          String?
  pricingDetails       String?
  aiGenerated          Boolean             @default(false)
  aiPrompt             String?
  aiOutput             String?
  applicationsCount    Int                 @default(0)
  likesCount           Int                 @default(0)
  messagesCount        Int                 @default(0)
  savedCount           Int                 @default(0)
  sharedCount          Int                 @default(0)
  viewsCount           Int                 @default(0)
  boosted              Boolean             @default(false)
  boostedUntil         DateTime?
  qualified            Boolean             @default(false)
  referralAvailable    Boolean             @default(false)
  referralAmount       Decimal?            @db.Decimal(12, 2)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  trendingScore        Float               @default(0)
  applications         Application[]
  likedBy              LikedOpportunity[]
  applicationProcess   ApplicationProcess? @relation(fields: [applicationProcessId], references: [id], onDelete: SetNull)
  feature              Feature?            @relation(fields: [featureId], references: [id], onDelete: SetNull)
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  publicDiscussions    PublicDiscussion[]
  referralCodes        ReferralCode[]
  savedBy              SavedOpportunity[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([featureId])
  @@index([type])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([trendingScore(sort: Desc)])
  @@index([expirationDate])
  @@index([status, expirationDate])
  @@index([deletedAt])
  @@index([boostedUntil])
  @@index([name])
  @@map("opportunities")
}

model ApplicationProcess {
  id                   String        @id @default(cuid())
  name                 String        @unique
  description          String?
  candidateDescription String?
  opportunities        Opportunity[]

  @@map("application_processes")
}

model Application {
  id               String           @id @default(cuid())
  opportunityId    String
  candidateId      String
  title            String?
  goalLetter       String?
  submissionDate   DateTime?
  stage            ApplicationStage @default(DRAFT)
  isClosed         Boolean          @default(false)
  isDraft          Boolean          @default(true)
  reviewDate       DateTime?
  reviewFeedback   String?
  feedbackTitle    String?
  referralCodeUsed String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  externalLink     String?
  externalLink2    String?
  attachmentUrl    String?
  deletedAt        DateTime?
  candidate        User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  opportunity      Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, candidateId])
  @@index([candidateId])
  @@index([candidateId, deletedAt])
  @@index([opportunityId])
  @@index([opportunityId, deletedAt])
  @@index([opportunityId, stage])
  @@index([stage])
  @@index([createdAt])
  @@map("applications")
}

/// DB-level CHECK (see migration 0019) enforces that privateDiscussionId and
/// publicDiscussionId are never both set and never both null.
model Message {
  id                  String             @id @default(cuid())
  clientMessageId     String?            @unique
  content             String
  senderId            String
  receiverId          String?
  privateDiscussionId String?
  publicDiscussionId  String?
  createdAt           DateTime           @default(now())
  privateDiscussion   PrivateDiscussion? @relation(fields: [privateDiscussionId], references: [id], onDelete: Cascade)
  publicDiscussion    PublicDiscussion?  @relation(fields: [publicDiscussionId], references: [id], onDelete: Cascade)
  receiver            User?              @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  sender              User               @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([senderId, createdAt(sort: Desc)])
  @@index([receiverId])
  @@index([privateDiscussionId])
  @@index([publicDiscussionId])
  @@map("messages")
}

model PrivateDiscussion {
  id            String        @id @default(cuid())
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      Message[]
  participants  Participant[] @relation("PrivateDiscussionParticipants")

  @@index([lastMessageAt])
  @@map("private_discussions")
}

model Participant {
  id           String            @id @default(cuid())
  userId       String
  discussionId String
  joinedAt     DateTime          @default(now())
  unreadCount  Int               @default(0)
  // Timestamp of this participant's last "mark as read" action. Null means
  // never read — lets the nightly counter-resync cron recompute unreadCount
  // from message history instead of only ever resetting it to 0.
  lastReadAt   DateTime?
  discussion   PrivateDiscussion @relation("PrivateDiscussionParticipants", fields: [discussionId], references: [id], onDelete: Cascade)
  user         User              @relation("PrivateDiscussionParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@index([userId])
  @@index([discussionId])
  @@map("participants")
}

model PublicDiscussion {
  id            String         @id @default(cuid())
  title         String
  description   String?
  image         String?
  type          DiscussionType @default(OPEN_FORUM)
  ownerId       String
  opportunityId String?
  messagesCount Int            @default(0)
  membersCount  Int            @default(0)
  likesCount    Int            @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      Message[]
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([opportunityId])
  @@index([type])
  @@index([lastMessageAt(sort: Desc)])
  @@map("public_discussions")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
  @@map("saved_opportunities")
}

model LikedOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
  @@map("liked_opportunities")
}

model Rating {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
  @@index([userId])
  @@map("ratings")
}

model Task {
  id              String     @id @default(cuid())
  userId          String
  relatedItemId   String?
  relatedItemType String?
  name            String
  description     String?
  status          TaskStatus @default(TODO)
  dueDate         DateTime?
  url             String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("tasks")
}

model ReferralCode {
  id              String         @id @default(cuid())
  code            String         @unique
  ownerId         String
  opportunityId   String?
  type            ReferralType?
  status          ReferralStatus @default(PENDING)
  amount          Decimal?       @db.Decimal(12, 2)
  usesCount       Int            @default(0)
  potentialAmount Decimal?       @default(0) @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([code])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("referral_codes")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model Industry {
  id                 String  @id @default(cuid())
  name               String  @unique
  description        String?
  opportunitiesCount Int     @default(0)

  @@map("industries")
}

model Market {
  id    String  @id @default(cuid())
  name  String  @unique
  image String?

  @@map("markets")
}

model Feature {
  id                  String        @id @default(cuid())
  name                String        @unique
  description         String?
  category            String?
  order               Int?
  aiPrompt            String?
  seekerName          String?
  creatorName         String?
  seekerScenario      String?
  creatorScenario     String?
  displayType         String?
  noApplicationNeeded Boolean       @default(false)
  opportunitiesCount  Int           @default(0)
  opportunities       Opportunity[]

  @@map("features")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetId   String?
  targetType String?
  details    String?
  createdAt  DateTime @default(now())
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
  @@index([targetId, targetType])
  @@map("admin_audit_logs")
}

model NotificationPreferences {
  id                        String  @id @default(cuid())
  userId                    String  @unique
  emailApplicationSubmitted Boolean @default(true)
  emailApplicationReviewed  Boolean @default(true)
  emailApplicationAccepted  Boolean @default(true)
  emailOpportunityApproved  Boolean @default(true)
  emailNewMessage           Boolean @default(true)
  emailNewFollower          Boolean @default(true)
  inAppApplicationSubmitted Boolean @default(true)
  inAppApplicationReviewed  Boolean @default(true)
  inAppApplicationAccepted  Boolean @default(true)
  inAppOpportunityApproved  Boolean @default(true)
  inAppNewMessage           Boolean @default(true)
  inAppNewFollower          Boolean @default(true)
  emailOpportunityRejected  Boolean @default(true)
  inAppOpportunityRejected  Boolean @default(true)
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum UserRole {
  USER
  ADMIN
}

enum OpportunityType {
  JOB_OPPORTUNITY
  TALENT_PROFILE
  CO_FOUNDER_OPPORTUNITY
  CO_FOUNDER_PROFILE
  BUSINESS_IDEA
  SUPPORT_OFFER
  SERVICE_LISTING
  SERVICE_REQUEST
  DEAL_FLOW
  INVESTOR_THESIS
  INVESTOR_PROFILE
  FUNDING_OPPORTUNITY
  EVENT
  CALL_FOR_STARTUPS
  MENTORSHIP_BA_OFFER
  PROJECT_SEEKING_SUPPORT
  VENTURE_PROGRAM
  CHILL_WORK_SPOT
  MARKET_ADVISOR
}

enum OpportunityStatus {
  DRAFT
  PENDING
  ACTIVE
  ARCHIVED
  CLOSED
}

enum ApplicationStage {
  DRAFT
  SUBMITTED
  OWNER_REVIEW
  READY_TO_SUBMIT
  SUCCESS
  ARCHIVED
}

enum DiscussionType {
  OPEN_FORUM
  OPPORTUNITY_RELATED
}

enum TaskStatus {
  TODO
  WORKING_ON_IT
  IDEA
  DONE
}

enum ReferralType {
  NEW_USER
  TALENT_HUNT
  OPPORTUNITY_RELATED
}

enum ReferralStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED
}
